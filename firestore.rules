rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isPermittedUser(userId) {
      return isOwner(userId) || userId == 'isowri4ku_vault_primary' || userId.matches('^anon_.*');
    }

    match /users/{userId} {
      allow read, write: if isValidId(userId) && isPermittedUser(userId);

      match /medical_reports/{reportId} {
        allow read, write, delete: if isValidId(reportId) && isPermittedUser(userId);
      }

      match /tasks/{taskId} {
        allow read, write, delete: if isValidId(taskId) && isPermittedUser(userId);
      }

      match /logs/{logId} {
        allow read, write, delete: if isValidId(logId) && isPermittedUser(userId);
      }
    }
  }
}
